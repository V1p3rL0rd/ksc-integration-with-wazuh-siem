# Copy to config.env (git-ignored), set real values, then:
#   sudo chown root:root config.env && sudo chmod 600 config.env
# The file is parsed as KEY=VALUE, it is never executed. Environment variables override it.
# Example values below use the documentation range 192.0.2.0/24 (RFC 5737).

# IP of the Kaspersky Security Center Administration Server: the ONLY host allowed to send syslog
KSC_IP=192.0.2.5

# IP of this Wazuh manager to bind the syslog port to (must be configured on this host)
LISTEN_IP=192.0.2.7

# Must match KSC: Administration Server properties -> Export to SIEM system -> Parameters
SYSLOG_PORT=514
SYSLOG_PROTOCOL=tcp

# Wazuh layout
OSSEC_DIR=/var/ossec
SERVICE_NAME=wazuh-manager

# Backups of ossec.conf / decoder / rules taken before every change (root-only, 0700)
BACKUP_ROOT=/root/ksc-integration-with-wazuh-siem-backups
BACKUP_KEEP=10

# Rule ID range reserved for this integration (checked against all other rules)
RULE_ID_MIN=100700
RULE_ID_MAX=100799

# Known, unrelated ossec.log errors to ignore after restart (extended regex), e.g.:
# LOG_IGNORE_REGEX=Invalid group: Default
LOG_IGNORE_REGEX=

# Seconds to wait for agents to reconnect after the manager restart
AGENT_RECOVERY_TIMEOUT=180
